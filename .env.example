# The original lifecycle stays simulated. Guarded hardware commands default off.
ECURIOUS_MODE=mock
PORT=3000
HOST=127.0.0.1

# Use HOST=0.0.0.0 to let Expo Go reach the simulator on your local network.
# The mobile launcher enables this for its own server process.

# Optional real, read-only parking-lock diagnostics. Keep the actual key in .env.
# The simulator remains independent. Guarded hardware writes require setup below.
ECURIOUS_BASE_URL=https://parking-lock-service-production.up.railway.app
ECURIOUS_API_KEY=

# Designated hardware workflow only. Keep off until migration/enrollment,
# mentor-confirmed interlocks, fresh telemetry and safe access policy are ready.
ECURIOUS_COMMANDS_ENABLED=false
ECURIOUS_LOCK_IDS=
# Backend-only database worker credential. Never use EXPO_PUBLIC_ for this.
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
# Stable backend-only plate HMAC secret: base64-encoded cryptographic 32 bytes.
# Keep it across restarts; changing it invalidates camera matching for existing bookings.
BAYREADY_PLATE_HASH_KEY=
# Optional external OCR event sender; native Ecurious OCR does not need this token.
BAYREADY_VISION_TOKEN=
# Optional Management API token for npm run supabase:setup -- --inspect / --apply.
SUPABASE_ACCESS_TOKEN=

# GoingElectric key approved for this app. The launcher passes it to the phone for
# direct directory requests. Never commit the key or distribute exported bundles.
ELECTRIC_API_KEY=

# Shared app bookings. Use only a publishable or legacy anon key; root launchers
# pass these public settings to the phone. Apply supabase/migrations first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Existing SUPABASE_API_KEY is also accepted if it is a legacy anon key.

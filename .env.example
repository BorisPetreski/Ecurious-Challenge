# This starter runs a local simulation. Live operation is deliberately unavailable.
ECURIOUS_MODE=mock
PORT=3000
HOST=127.0.0.1

# Use HOST=0.0.0.0 to let Expo Go reach the simulator on your local network.
# The mobile launcher enables this for its own server process.

# Optional real, read-only parking-lock diagnostics. Keep the actual key in .env.
# Reservations and charging still use the simulator; hardware writes are disabled.
ECURIOUS_BASE_URL=https://parking-lock-service-production.up.railway.app
ECURIOUS_API_KEY=

# GoingElectric key approved for this app. The launcher passes it to the phone for
# direct directory requests. Never commit the key or distribute exported bundles.
ELECTRIC_API_KEY=

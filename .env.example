# This starter runs a local simulation. Live operation is deliberately unavailable.
ECURIOUS_MODE=mock
PORT=3000
HOST=127.0.0.1

# Use HOST=0.0.0.0 to let Expo Go reach the simulator on your local network.
# The mobile launcher enables this for its own server process.

# Copy to .env if you want to change the local port or host. Do not put real credentials
# here or commit them. Documented Ecurious integration must be implemented first.

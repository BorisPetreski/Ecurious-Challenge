# Optional: use a laptop address reachable from your phone.
# Normally inferred automatically from Expo's LAN development URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Optional when running Expo separately with a non-default simulator port.
# EXPO_PUBLIC_API_PORT=3000

# EXPO_PUBLIC_ values are visible in the app bundle. Never put hardware keys here.

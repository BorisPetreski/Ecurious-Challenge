# Optional: use a laptop address reachable from your phone.
# Normally inferred automatically from Expo's LAN development URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Optional when running Expo separately with a non-default simulator port.
# EXPO_PUBLIC_API_PORT=3000

# Only needed when starting Expo directly inside mobile/. Root launchers also
# accept ELECTRIC_API_KEY or GOINGELECTRIC_API_KEY from the root .env.
# EXPO_PUBLIC_GOINGELECTRIC_API_KEY=

# Shared Supabase demo bookings; root launchers infer these from root .env.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# EXPO_PUBLIC_ values are visible on the phone. Never put Ecurious hardware keys here.
